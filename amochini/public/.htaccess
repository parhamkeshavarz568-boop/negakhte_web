# ============================================================================
#  عمو چینی — amochini.ir
#  Apache / LiteSpeed configuration. Upload as .htaccess in the web root
#  (public_html/ on cPanel). It is a dotfile — turn on "show hidden files".
#
#  Generated by build/build.py from build/templates/htaccess.tpl.
#  Edit the template, not this file.
#
#  NOTE FOR NGINX: nginx ignores .htaccess entirely and silently. If this host
#  runs nginx, every rule below is a no-op and the migration redirects will not
#  happen. Confirm the web server before relying on this file.
# ============================================================================

# -MultiViews is not optional. With MultiViews on, Apache content-negotiates
# /brake-pads to whatever file loosely matches, bypassing the trailing-slash
# canonicalisation below and creating duplicate URLs.
Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# Root-relative, NOT absolute. An ErrorDocument pointing at a full URL turns
# into a 302 to that URL, which Google reads as a soft 404.
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# ----------------------------------------------------------------------------
# 1. CANONICAL HOST
#
#    HTTPS IS DELIBERATELY NOT FORCED. Read before changing.
#
#    The only URL Google has indexed for this domain is http://amochini.ir/ ,
#    and every image on the old WordPress site is served over http. A .ir
#    domain is hard to certificate: Sectigo — cPanel's default AutoSSL
#    provider — refuses to issue for .ir. Let's Encrypt does issue. If this
#    file forces https and no certificate is installed, the whole site becomes
#    unreachable for users and Googlebot, with nothing to tell you why.
#
#    TO ENABLE HTTPS, in this order:
#      1. Install a certificate (cPanel -> SSL/TLS Status -> AutoSSL with the
#         provider set to "Let's Encrypt", or run acme.sh).
#      2. From OUTSIDE Iran:  curl -I https://amochini.ir/
#         must return 200 with a valid chain.
#      3. Set SCHEME = "https" in build/site_config.py and rebuild, so every
#         canonical, og:url, JSON-LD @id and sitemap <loc> flips together.
#      4. Uncomment the two lines in section 8 at the bottom.
#    Step 4 without steps 1-3 is what takes the site down.
# ----------------------------------------------------------------------------

  # www -> non-www. Protocol-preserving, so it is safe with or without a cert.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ http://%1/$1 [R=301,L]

# ============================================================================
# 2. WORDPRESS LEGACY REDIRECTS   — added 2026-09-13
#    DO NOT REMOVE BEFORE 2027-09-13. Google expects a 301 to stay in place
#    for at least a year; removing these early throws away the signal they
#    carry. Keep this whole fenced block through any future redesign.
#
#    Ordering matters, and matters more on LiteSpeed: its [L] flag exits the
#    rewrite engine outright rather than restarting the loop. Order is:
#    410s -> query strings -> feeds/pagination -> explicit 301s -> catch-alls
#    -> trailing slash. Never wrap a rewrite in <FilesMatch> — LiteSpeed does
#    not run rules inside those.
# ============================================================================

  # --- 2a. dead WordPress surface -> 410 Gone --------------------------------
  # 410 rather than 404: both eventually de-index, but 410 does it in days
  # instead of months and keeps the Search Console coverage report readable.
  # None of these were ever ranking pages.
  RewriteRule ^wp-json(/|$)                    - [G,L]
  RewriteRule ^wp-admin(/|$)                   - [G,L]
  RewriteRule ^wp-includes(/|$)                - [G,L]
  RewriteRule ^wp-login\.php$                  - [G,L]
  RewriteRule ^wp-cron\.php$                   - [G,L]
  RewriteRule ^xmlrpc\.php$                    - [G,L]
  RewriteRule ^wp-content/(themes|plugins|cache)(/|$) - [G,L]
  RewriteRule ^author(/|$)                     - [G,L]

  # --- 2b. query-string permalinks -------------------------------------------
  # RewriteRule never sees the query string; these need RewriteCond. The
  # trailing "?" on each substitution drops the old query string — without it
  # Apache copies it onto the target. ("?" is used instead of [QSD] because it
  # is portable to LiteSpeed and older Apache.)
  RewriteCond %{QUERY_STRING} ^(p|page_id|product|attachment_id|cat|m)=[^&]+
  RewriteRule ^$ /? [R=301,L]

  # WooCommerce transient parameters were never indexable content.
  RewriteCond %{QUERY_STRING} (^|&)(add-to-cart|wc-ajax|removed_item|filter_|min_price|max_price)=
  RewriteRule ^ - [G,L]

  RewriteCond %{QUERY_STRING} (^|&)rest_route=
  RewriteRule ^ - [G,L]

  # WordPress internal search -> the largest category
  RewriteCond %{QUERY_STRING} (^|&)s=
  RewriteRule ^$ /brake-discs/? [R=301,L]

  # --- 2c. feeds and pagination -> 301, not 410 ------------------------------
  # Feeds get crawled and external readers may still link them, so redirect
  # rather than kill. Paginated archives are near-duplicates of page 1.
  RewriteRule ^comments/feed/?$                /  [R=301,L]
  RewriteRule ^feed/?$                         /  [R=301,L]
  RewriteRule ^(.+)/feed/?$                    /$1 [R=301,L]
  RewriteRule ^page/[0-9]+/?$                  /  [R=301,L]
  RewriteRule ^(.+?)/page/[0-9]+/?$            /$1 [R=301,L]
  RewriteRule ^20[0-9]{2}(/[0-9]{2})?(/[0-9]{2})?/?$ / [R=301,L]

  # --- 2d. legacy sitemap paths ----------------------------------------------
  # Google re-fetches a sitemap URL it has on file for months after the file
  # disappears. Redirect rather than 404 so those fetches land somewhere real.
  RewriteRule ^wp-sitemap.*\.xml$                                    /sitemap.xml [R=301,L]
  RewriteRule ^sitemap_index\.xml$                                   /sitemap.xml [R=301,L]
  RewriteRule ^(post|page|product|category|product_cat|product_tag)-sitemap[0-9]*\.xml$ /sitemap.xml [R=301,L]

  # --- 2e. exact per-product map ---------------------------------------------
  # Generated by build/make_redirects.py from the WordPress URL export.
  # See docs/MIGRATION.md. Absent = only the pattern rules below apply, which
  # is acceptable here because only the homepage is currently indexed.
  # (no per-product redirect map yet — run
  #  python3 build/make_redirects.py old-urls.txt
  #  BEFORE taking WordPress down. See docs/MIGRATION.md.)

  # --- 2f. WooCommerce structural bases --------------------------------------
  # These patterns match ASCII slugs AND percent-encoded Persian ones, because
  # ".+" covers both. Do not hand-write literal Persian slugs here — mod_rewrite
  # matches the DECODED path, so an encoded pattern never fires.
  RewriteRule ^product-category/لنت-ترمز/?$    /brake-pads/  [R=301,L]
  RewriteRule ^product-category/دیسک-چرخ/?$    /brake-discs/ [R=301,L]
  RewriteRule ^product-category/کاسه-چرخ/?$    /brake-drums/ [R=301,L]
  RewriteRule ^product-category/.+$            /brake-discs/ [R=301,L]
  RewriteRule ^product-tag/.+$                 /brake-discs/ [R=301,L]
  RewriteRule ^product/.+$                     /brake-discs/ [R=301,L]
  RewriteRule ^shop/?$                         /brake-discs/ [R=301,L]
  RewriteRule ^(cart|checkout|my-account)(/.*)?$ /contact/   [R=301,L]
  RewriteRule ^tag/[^/]+/?$                    /brake-discs/ [R=301,L]

  # --- 2g. common WordPress pages --------------------------------------------
  RewriteRule ^(about|about-us|درباره-ما)/?$      /about/   [R=301,L,NC]
  RewriteRule ^(contact|contact-us|تماس-با-ما)/?$ /contact/ [R=301,L,NC]
  RewriteRule ^(home|خانه)/?$                     /         [R=301,L,NC]

# ============================================================================
# 3. OLD IMAGE URLS
#    The right answer is NOT to redirect these. Copy the old wp-content/uploads
#    tree into this docroot at the identical path so the URLs keep returning
#    200 — changing an image URL loses its Google Images history, and a
#    redirect is a weaker signal than the file simply still being there.
#    See docs/MIGRATION.md step 3.
#
#    The rule below is the SAFETY NET for uploads that were not copied. It runs
#    only when the file genuinely is not on disk, so a copied tree is served
#    normally and is never redirected.
# ============================================================================
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^wp-content/uploads/.+\.(jpe?g|png|webp|gif)$ /assets/img/disc-plain-700.jpg [R=301,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^wp-content/uploads/.*$ - [G,L]

# ============================================================================
# 4. TRAILING SLASH
#    Our pages are directories. Without this, /brake-pads and /brake-pads/
#    both resolve and Google sees duplicate content.
# ============================================================================
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

</IfModule>

# ============================================================================
# 5. COMPRESSION
#    HTML is ~27 KB/page and gzips to about 6 KB. WebP and WOFF2 are already
#    compressed — re-compressing costs CPU and saves nothing.
# ============================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/manifest+json
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
</IfModule>

# ============================================================================
# 6. CACHING
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType application/json       "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|avif|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    # max-age=0 + must-revalidate: the pages carry prices, so a stale copy is
    # worse than a conditional request. Revalidation is a 304, not a re-download.
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ============================================================================
# 7. MIME TYPES + SECURITY
#    Some Iranian shared hosts still send WebP and WOFF2 as
#    application/octet-stream, which makes browsers silently refuse them.
# ============================================================================
# Speculation Rules must be served with their own media type, and only this
# one file — not every .json on the site.
<Files "speculation-rules.json">
  ForceType application/speculationrules+json
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=86400"
  </IfModule>
</Files>

<IfModule mod_mime.c>
  AddType image/avif                  .avif
  AddType image/webp                  .webp
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
  AddType image/svg+xml               .svg
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # The site loads zero third-party resources, so this can be strict.
  # 'unsafe-inline' is present for style-src only (a few layout styles are
  # inline); script-src has no such exception.
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  # Points at /speculation-rules.json (see above). The quotes are part of the
  # header value — it is a structured-field string, not a bare URL.
  Header set Speculation-Rules "\"/speculation-rules.json\""
  Header always unset X-Powered-By
  Header unset Server
</IfModule>

# Source files must never be served if they get uploaded by mistake.
<FilesMatch "\.(py|md|log|bak|sql|zip|tpl|conf)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
# ...but the JSON the site itself needs must stay reachable.
<FilesMatch "^(search-index\.json|site\.webmanifest|speculation-rules\.json)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>

# ============================================================================
# 8. HTTPS — COMMENTED OUT ON PURPOSE
#    Read section 1 before enabling. Uncomment ONLY after a certificate is
#    installed and verified from outside Iran, and after setting
#    SCHEME = "https" in build/site_config.py and rebuilding.
# ============================================================================
# <IfModule mod_rewrite.c>
#   RewriteCond %{HTTPS} !=on
#   RewriteRule ^(.*)$ https://amochini.ir/$1 [R=301,L]
# </IfModule>
