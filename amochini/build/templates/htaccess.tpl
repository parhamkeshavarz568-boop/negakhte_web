# ============================================================================
#  amochini.ir — Apache / LiteSpeed configuration
#  Generated by build/build.py — edit build/templates/htaccess.tpl, not this.
#
#  Upload this file as  .htaccess  in the same folder as index.html.
#  On cPanel that is usually  public_html/
# ============================================================================

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# ----------------------------------------------------------------------------
# 1. CANONICAL HOST + HTTPS
#    One redirect, not two. Sending http://www -> https://www -> https:// costs
#    an extra round trip and dilutes link equity through a chain.
#    NOTE: this block assumes an SSL certificate is already installed. If HTTPS
#    is not yet active, comment out this whole block or every request 500s.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://amochini.ir/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------------
# 2. WORDPRESS -> STATIC MIGRATION REDIRECTS
#
#    The site previously ran WordPress/WooCommerce. Every URL Google has
#    indexed must resolve, or the rankings built up on those URLs are lost.
#    Rules are ordered most-specific first.
# ----------------------------------------------------------------------------
<IfModule mod_rewrite.c>

  # --- 2a. exact product URL map -------------------------------------------
  # Generated from the WordPress export. See docs/MIGRATION.md.
  # If this file is missing the site still works; only the per-product
  # redirects are skipped.
  # __PRODUCT_REDIRECTS__

  # --- 2b. WooCommerce category archives ------------------------------------
  RewriteRule ^product-category/lent-tormoz/?$      /brake-pads/  [R=301,L,NC]
  RewriteRule ^product-category/disk-charkh/?$      /brake-discs/ [R=301,L,NC]
  RewriteRule ^product-category/kase-charkh/?$      /brake-drums/ [R=301,L,NC]
  # Any other product category falls back to the shop root rather than 404.
  RewriteRule ^product-category/.*$                 /brake-discs/ [R=301,L,NC]
  RewriteRule ^product-tag/.*$                      /brake-discs/ [R=301,L,NC]

  # --- 2c. shop / cart / account -------------------------------------------
  RewriteRule ^shop/?$                              /brake-discs/ [R=301,L,NC]
  RewriteRule ^(cart|checkout|my-account)/?.*$      /contact/     [R=301,L,NC]

  # --- 2d. a product URL we have no explicit mapping for --------------------
  # Send it to the discs listing (the largest category) rather than 404.
  RewriteRule ^product/.*$                          /brake-discs/ [R=301,L,NC]
  RewriteRule ^products?/?$                         /brake-discs/ [R=301,L,NC]

  # --- 2e. common WordPress pages -------------------------------------------
  RewriteRule ^(about|about-us|درباره-ما)/?$        /about/       [R=301,L,NC]
  RewriteRule ^(contact|contact-us|تماس-با-ما)/?$   /contact/     [R=301,L,NC]
  RewriteRule ^(home|خانه)/?$                       /            [R=301,L,NC]

  # --- 2f. ?p=123 and ?page_id=12 style permalinks ---------------------------
  # WordPress default permalinks live in the query string, so RewriteRule
  # alone cannot see them — they need a RewriteCond on QUERY_STRING.
  RewriteCond %{QUERY_STRING} (^|&)(p|page_id|product)=\d+
  RewriteRule ^$ /? [R=301,L]

  # WordPress internal search -> our category page
  RewriteCond %{QUERY_STRING} (^|&)s=
  RewriteRule ^$ /brake-discs/? [R=301,L]

  # --- 2g. images: preserve Google Images equity -----------------------------
  # The two product photos WordPress served. Redirecting rather than 404ing
  # keeps whatever image rankings exist and stops hotlinks from breaking.
  RewriteRule ^wp-content/uploads/2026/08/TVuDoFaRQL.*\.jpe?g$ /assets/img/disc-plain-700.jpg [R=301,L,NC]
  RewriteRule ^wp-content/uploads/2026/08/images-1-1\.png$     /assets/img/cat-brake-pads-400.jpg [R=301,L,NC]
  # Any other old upload -> 410 Gone. 410 tells Google to drop it fast;
  # a soft 404 lingers in the index for months.
  RewriteRule ^wp-content/uploads/.*$ - [G,L]

  # --- 2h. dead WordPress surface -------------------------------------------
  # 410 Gone, not 404: these will never come back, and 410 de-indexes faster.
  RewriteRule ^wp-json(/.*)?$        - [G,L]
  RewriteRule ^xmlrpc\.php$          - [G,L]
  RewriteRule ^wp-(login|cron|links-opml|trackback)\.php$ - [G,L]
  RewriteRule ^(.*/)?feed/?$         - [G,L]
  RewriteRule ^comments/feed/?$      - [G,L]
  RewriteRule ^author/.*$            - [G,L]
  RewriteRule ^\d{4}/\d{2}(/\d{2})?/?$ - [G,L]
  # wp-admin: send humans to the homepage instead of a scary error
  RewriteRule ^wp-admin(/.*)?$       / [R=301,L]
  RewriteRule ^wp-content/(plugins|themes)/.*$ - [G,L]

  # --- 2i. trailing slash normalisation --------------------------------------
  # Our pages are directories: /brake-pads/ not /brake-pads.
  # Add the slash so both spellings do not both resolve (duplicate content).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# ----------------------------------------------------------------------------
# 3. COMPRESSION
#    HTML is ~27 KB/page; gzip takes that to roughly 6 KB. WebP and WOFF2 are
#    already compressed, so they are excluded — re-compressing costs CPU and
#    saves nothing.
# ----------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------------
# 4. CACHING
#    Fonts and images are content-stable and get a year. HTML gets an hour so
#    a price change reaches visitors the same day.
# ----------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType text/css               "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/html              "access plus 1 hour"
  ExpiresByType application/json       "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------------
# 5. MIME TYPES
#    Some Iranian shared hosts still send WebP and WOFF2 as
#    application/octet-stream, which makes browsers refuse them silently.
# ----------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/webp                  .webp
  AddType font/woff2                  .woff2
  AddType application/manifest+json   .webmanifest
  AddType image/svg+xml               .svg
</IfModule>

# ----------------------------------------------------------------------------
# 6. SECURITY HEADERS
#    The site loads zero third-party resources, so the CSP can be strict.
#    'unsafe-inline' is present for style-src only because a few layout
#    styles are inline; script-src has no such exception.
# ----------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
  Header always unset X-Powered-By
  Header unset Server
</IfModule>

# Block access to source/build files if they ever get uploaded by mistake
<FilesMatch "\.(py|json|md|log|bak|sql|zip|tpl)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>
# ...but the two JSON files the site itself needs must stay reachable
<FilesMatch "^(search-index\.json|site\.webmanifest)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
</FilesMatch>
