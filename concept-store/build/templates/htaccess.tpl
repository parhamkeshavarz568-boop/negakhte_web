# ============================================================================
#  __NAME__ — Apache / LiteSpeed configuration.
#  Upload as .htaccess next to index.html (public_html/ on cPanel, or the
#  folder set as SITE["base"]). It is a dotfile: turn on "show hidden files".
#
#  Generated by build/build.py from build/templates/htaccess.tpl.
#  Edit the template, not this file.
#
#  NGINX ignores .htaccess entirely and silently. If the host runs nginx,
#  none of this applies: the site still works, but without the caching,
#  compression and the real 404 page. Confirm the web server first.
# ============================================================================

# -MultiViews: otherwise Apache content-negotiates /candles to whatever loosely
# matches and bypasses the trailing-slash rule, creating duplicate URLs.
Options -MultiViews -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8

# A path, NOT a full URL. A full URL here turns into a 302, which search
# engines read as a soft 404.
ErrorDocument 404 __BASE__/404.html

# AVIF is newer than many hosts' MIME tables. Served as application/octet-stream
# it does not display at all, so declare it. The rest are for older hosts.
AddType image/avif .avif
AddType image/webp .webp
AddType font/woff2 .woff2
AddType image/svg+xml .svg

<IfModule mod_rewrite.c>
RewriteEngine On

  # www -> bare domain. Protocol-preserving, so it is safe with or without a
  # certificate.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1__BASE__/$1 [R=301,L]

  # HTTPS — deliberately NOT forced. Forcing it on a host with no certificate
  # takes the whole site offline with nothing to say why. Turn it on only after
  #   1. a certificate is installed (cPanel -> SSL/TLS Status -> AutoSSL; for a
  #      .ir domain set the provider to Let's Encrypt — Sectigo refuses .ir), and
  #   2. https://<domain>/ opens with a valid padlock,
  # then uncomment these two lines and set SITE["url"] to https:// and rebuild.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}__BASE__/$1 [R=301,L]

  # Every page is a folder. Without this /candles and /candles/ both resolve
  # and count as two pages.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ __BASE__/$1/ [R=301,L]
</IfModule>

# ============================================================================
# COMPRESSION — HTML and CSS shrink ~5x. Images and WOFF2 are already
# compressed; compressing them again costs CPU and saves nothing.
# ============================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# ============================================================================
# CACHING
#   images, fonts   a year. A photo's file name never changes for different
#                   pixels: a new photo gets a new name.
#   CSS, JS         a year too — every page links them as site.css?v=<hash>,
#                   so a change is a new URL and nobody sees a stale style.
#   HTML            always revalidated, so a new price shows up at once.
# ============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 month"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html              "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|png|woff2|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Fonts are fetched with crossorigin (they are preloaded); allow it.
  <FilesMatch "\.woff2$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>

  # Plain hardening that costs nothing and breaks nothing on a static site.
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Never serve the build's leftovers if someone uploads the whole repo by mistake.
<FilesMatch "\.(py|pyc|tpl|md|sh|json\.bak)$">
  Require all denied
</FilesMatch>
